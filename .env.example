# MediQ OPD Environment Configuration Template
# Copy this file to .env and replace placeholder values

# Server & Environment
PORT=8080
NODE_ENV=development

# Redis (Queue Pacing, Atomic Locks & OTP TTL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL (EMR Ledger, Audit Logs & Patient Master)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mediq_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Firebase Web App Config (Public)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=mediq-health.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mediq-health
VITE_FIREBASE_STORAGE_BUCKET=mediq-health.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Hyperlocal Pharmacy & Jan Aushadhi API
JAN_AUSHADHI_API_URL=https://janaushadhi.gov.in/api/v1
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
