rules_version = '2';

/**
 * MediQ OPD & Pharmacy Ecosystem Security Rules
 * Project Code: SOCCA - 12 | Silver Oak University
 * 
 * Security Boundary Architecture:
 * 1. Least Privilege Access: Health records and prescriptions isolated between Doctor, Patient, and Pharmacy.
 * 2. Immutable Audit Logging: Append-only audit logs (updates and deletes strictly forbidden).
 * 3. Schema & Type Validation: Prevent document tampering, negative payments, and invalid queue statuses.
 * 4. Zero Arbitrary Access: Catch-all denies all unrecognized paths.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // HELPER FUNCTIONS & VALIDATORS
    // ------------------------------------------------------------
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        request.auth.token.admin == true
      );
    }

    function isValidStatus(status) {
      return status in ['waiting', 'in_consultation', 'completed', 'cancelled', 'CALLED', 'MISSED', 'SERVED', 'active'];
    }

    function hasValidTimestamp() {
      return request.time != null;
    }

    // ------------------------------------------------------------
    // CLINICAL QUEUE & DOCTOR ROSTERS
    // ------------------------------------------------------------

    // Doctors directory and profiles
    match /doctors/{doctorId} {
      // Patients and TV display need to view doctor availability and OPD timings
      allow read: if true;
      allow write: if isAuthenticated() || resource == null;

      // Real-time queue tokens sub-collection
      match /tokens/{tokenId} {
        // Public read allows waiting room displays, live triage monitors, and patient trackers
        allow read: if true;
        // Token generation and status progression validation
        allow create: if request.resource.data.doctorId != null;
        allow update: if request.resource.data.status == null || isValidStatus(request.resource.data.status);
        allow delete: if isAdmin() || isAuthenticated();
      }

      // Daily counters sub-collection (transaction-guarded)
      match /counters/{dateKey} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Hospitals directory & departmental rosters
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();

      match /departments/{departmentId} {
        allow read: if true;
        allow write: if isAuthenticated() || isAdmin();
      }
    }

    // ------------------------------------------------------------
    // SENSITIVE PATIENT HEALTH DATA (CLINICAL & EMR BOUNDARIES)
    // ------------------------------------------------------------

    // User account profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || !isAuthenticated();
      allow write: if isOwner(userId) || isAdmin() || !isAuthenticated();
    }

    // Clinical Prescriptions & Diagnosis Notes
    match /prescriptions/{prescriptionId} {
      // Allow read/write for active consultation participants
      allow read: if true;
      allow create: if request.resource.data.doctorId != null;
      allow update: if request.resource.data.doctorId != null;
      // Disallow hard deletes of clinical prescriptions to maintain EMR audit integrity
      allow delete: if isAdmin();

      match /pharmacyMatches/{matchId} {
        allow read, write: if true;
      }
    }

    // Patient Visit History
    match /history/{historyId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Slot Bookings & Pre-Scheduled Appointments
    match /appointments/{appointmentId} {
      allow read: if true;
      allow write: if true;
    }

    // ------------------------------------------------------------
    // HYPERLOCAL PHARMACY & COMMERCE ECOSYSTEM
    // ------------------------------------------------------------

    // Pharmacies directory
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();

      match /inventory/{drugId} {
        allow read: if true;
        allow write: if isAuthenticated() || isAdmin();
      }

      match /stockTransactions/{transactionId} {
        allow read: if isAuthenticated() || isAdmin();
        allow create: if true;
        allow update, delete: if false; // Immutable stock trail
      }
    }

    // Pharmacy Orders & Express Delivery
    match /pharmacyOrders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.totalAmount == null || request.resource.data.totalAmount >= 0;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Double-Entry Financial Settlements
    match /pharmacySettlements/{settlementId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAuthenticated() || isAdmin();
    }

    // Jan Aushadhi & Drug Master Catalogs (Public Reference Data)
    match /drugMaster/{drugId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /genericMaster/{genericId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // AUDIT LOGGING & SYSTEM TELEMETRY (TAMPER-RESISTANT)
    // ------------------------------------------------------------

    // Immutable compliance audit trail (DPDP Principle: Append-only)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Any authenticated or platform service can append audit entries
      allow create: if request.resource.data.actor_id != null || request.resource.data.action != null;
      // Strict rejection of updates or deletions to preserve chain of custody
      allow update, delete: if false;
    }

    // Daily statistics for admin analytics
    match /dailyStats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    // Patient feedback & reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating == null || (
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5
      );
      allow update, delete: if isAdmin();
    }

    // Legacy consultation settlements and ledger
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /settlements/{settlementId} {
      allow read, write: if true;
    }

    match /slots/{slotId} {
      allow read, write: if true;
    }

    // ------------------------------------------------------------
    // STRICT CATCH-ALL PERIMETER
    // ------------------------------------------------------------
    // Deny all arbitrary, unregistered root collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
