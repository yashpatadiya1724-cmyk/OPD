rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Doctors collection and sub-collections
    match /doctors/{doctorId} {
      allow read, write: if true;

      // Tokens sub-collection
      match /tokens/{tokenId} {
        allow read, write: if true;
      }

      // Daily counters sub-collection (transaction-guarded)
      match /counters/{dateKey} {
        allow read, write: if true;
      }
    }

    // Pharmacy tokens & counters (Section 7.10 & 7.11)
    match /pharmacy_tokens/{tokenId} {
      allow read, write: if true;
    }

    match /pharmacyCounters/{counterId} {
      allow read, write: if true;
    }

    // Staff & Patient User accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Daily statistics for Admin analytics
    match /dailyStats/{statId} {
      allow read, write: if true;
    }

    // Hospitals directory (Zomato for hospitals)
    match /hospitals/{hospitalId} {
      allow read, write: if true;
    }

    // Patient Reviews & Ratings
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Slot Bookings & Appointments
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // OPD Visit History
    match /history/{historyId} {
      allow read, write: if true;
    }

    // Catch-all fallback for open clinical demo ecosystem
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
